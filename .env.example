# Copy to `.env` in this directory for local development.
# Never commit `.env` or paste real secrets into git.

# --- Backend (server.py) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Firebase Cloud Messaging (optional)
# Production: set FIREBASE_SERVICE_ACCOUNT_KEY to the full JSON string.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=backend/firebase-service-account.json
FIREBASE_PROJECT_ID=

# AWS (optional — used for Bedrock/Claude features)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# --- Frontend / Expo (safe to embed in the mobile app) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Legacy alias read by app.config.js when EXPO_PUBLIC_BACKEND_URL is unset
BACKEND_URL=http://localhost:8000
