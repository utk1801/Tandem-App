# Copy to `frontend/.env` for local Expo development.
# For EAS production builds, set the same EXPO_PUBLIC_* values as EAS Secrets.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Set to 1 when using a free Apple ID (personal team) for device builds.
# Removes Push Notifications capability — required because personal teams can't use push.
EXPO_PUBLIC_IOS_PERSONAL_TEAM=1
